      "@shared/*": ["shared/*"]
    },
    "types": ["vite/client"]
  },

  "references": [
    { "path": "customer/tsconfig.json" },
    { "path": "employee/tsconfig.json" },
    { "path": "manager/tsconfig.json" }
  ]
